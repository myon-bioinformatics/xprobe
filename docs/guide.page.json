{
  "schema": "web-ui-page/1",
  "title": "xprobe 利用ガイド",
  "theme": "modern",
  "description": "テキスト検索・境界ケースの探索・失敗に寄せたテスト支援（xgrep + xfail + α）。読み取り専用。",
  "icon": "./icon.png",
  "favicon": "./favicon.png",
  "blocks": [
    {
      "type": "badges",
      "items": [
        "📄 単一ファイル",
        "🧰 標準ライブラリのみ",
        "🐍 Python 3.11+",
        "👀 読み取り専用"
      ]
    },
    {
      "type": "tabs",
      "id": "guide",
      "tabs": [
        {
          "label": "🧩 使い方",
          "blocks": [
            {
              "type": "section",
              "title": "📥 取得",
              "blocks": [
                {
                  "type": "text",
                  "text": "1 ファイルを置くだけで動きます（pip 不要）。"
                },
                {
                  "type": "output",
                  "text": "curl -fsSLO https://raw.githubusercontent.com/myon-bioinformatics/xprobe/main/xprobe.py"
                }
              ]
            },
            {
              "type": "section",
              "title": "▶️ 実行",
              "blocks": [
                {
                  "type": "card",
                  "title": "🔎 検索",
                  "text": "文字どおりに探します（--regex で正規表現）。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "python xprobe.py --search __version__ --root xprobe.py --brief"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "🏷️ 名前つき正規表現",
                  "text": "組み込みの正規表現を一覧します（--preset NAME で使用）。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "python xprobe.py --presets"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "🧬 定義を探す",
                  "text": "Python の関数・クラス定義を JSON で出します。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "python xprobe.py --symbols xprobe.py --symbol-pattern 'run_*'"
                    }
                  ]
                },
                {
                  "type": "card",
                  "title": "🧪 JUnit XML",
                  "text": "手元にある JUnit XML を読み、失敗・エラーのテスト名を JSON に出します。pytest は読み取りには不要です。",
                  "blocks": [
                    {
                      "type": "output",
                      "text": "python -S xprobe.py --junit pytest-results.xml"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "label": "🔬 検証ガイド",
          "blocks": [
            {
              "type": "runbook",
              "id": "verify",
              "books": [
                {
                  "label": "🐍 python",
                  "intro": "🤖 のついた手順は CI で実際に動かし、出た結果をそのまま載せています。",
                  "runbook": {
                    "key": "xprobe/python",
                    "steps": [
                      {
                        "id": "get",
                        "title": "📥 ファイルを置く",
                        "command": "curl -fsSLO https://raw.githubusercontent.com/myon-bioinformatics/xprobe/main/xprobe.py",
                        "needs": "🌐 ネットワーク"
                      },
                      {
                        "id": "help",
                        "title": "❓ ヘルプ",
                        "command": "python xprobe.py --help",
                        "run": true
                      },
                      {
                        "id": "find",
                        "title": "🔎 文字どおりに探す",
                        "command": "python xprobe.py --search __version__ --root xprobe.py --brief",
                        "run": true
                      },
                      {
                        "id": "presets",
                        "title": "🏷️ 名前つき正規表現",
                        "command": "python xprobe.py --presets",
                        "run": true
                      },
                      {
                        "id": "symbols",
                        "title": "🧬 定義を探す",
                        "command": "python xprobe.py --symbols xprobe.py --symbol-pattern 'run_*'",
                        "run": true
                      }
                    ]
                  }
                },
                {
                  "label": "⚡ uv",
                  "intro": "uv で Python 3.11 以上を選んで実行します。",
                  "runbook": {
                    "key": "xprobe/uv",
                    "steps": [
                      {
                        "id": "get",
                        "title": "📥 ファイルを置く",
                        "command": "curl -fsSLO https://raw.githubusercontent.com/myon-bioinformatics/xprobe/main/xprobe.py",
                        "needs": "🌐 ネットワーク"
                      },
                      {
                        "id": "help",
                        "title": "❓ ヘルプ",
                        "command": "uv run --no-project --python \">=3.11\" python -S xprobe.py --help",
                        "run": true
                      }
                    ]
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "title": "🔗 リンク",
      "blocks": [
        {
          "type": "links",
          "items": [
            {
              "label": "📖 README",
              "href": "https://github.com/myon-bioinformatics/xprobe#readme"
            },
            {
              "label": "📄 xprobe.py",
              "href": "https://github.com/myon-bioinformatics/xprobe/blob/main/xprobe.py"
            },
            {
              "label": "📐 設計",
              "href": "https://github.com/myon-bioinformatics/xprobe/blob/main/docs/design.md"
            }
          ]
        }
      ]
    }
  ]
}
